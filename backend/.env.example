# Port the API and Socket.io server listen on
API_Port=5000

# MongoDB connection string (local instance or Atlas)
MONGO_URL=mongodb://localhost:27017/emsichat

# Secret used to sign JSON Web Tokens
JWT_SECRET=change-me

# Optional: paths to a TLS key/certificate. If both files exist the server
# starts over HTTPS, otherwise it falls back to plain HTTP.
SSL_KEY_PATH=ssl/localhost.key
SSL_CERT_PATH=ssl/localhost.crt
